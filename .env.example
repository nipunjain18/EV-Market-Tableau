# ===================================================
# EV360 Market Analysis - Environment Configuration
# ===================================================

# Tableau Public URLs (Pre-configured defaults for Nipun Jain's live views)
TABLEAU_STORY_URL=https://public.tableau.com/views/EVMarketAnalysis_17932840807840/Story1?:language=en-US&publish=yes&:display_count=n&:origin=viz_share_link
TABLEAU_DASHBOARD_URL=https://public.tableau.com/views/EVMarketAnalysis_17932840807840/MarketOverview

# Flask & Production Server Configuration
# Note: On Render, PORT is assigned dynamically by the host platform
PORT=5000
FLASK_DEBUG=False

# Local Development / Data Pipeline Database Configuration
# (Optional: Only used by offline loader script scripts/load_to_db.py; not required by Flask runtime)
USE_MYSQL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ev_db
